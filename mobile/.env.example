# Copy to .env.local and adjust.
# On a physical phone, localhost won't work: use your computer's LAN IP (e.g. http://192.168.1.20:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080
# Dev-mode identity until Firebase Auth is wired up (backend must run with the "local" profile)
EXPO_PUBLIC_DEV_USER=dev-ian
