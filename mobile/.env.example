# Copy to .env.local (optional).
#
# API URL: leave unset in normal dev. The app talks to port 8080 on the same machine
# Expo is serving from, so it follows your laptop's IP automatically.
# Set it only to point at a deployed API or when using `expo start --tunnel`.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# Dev-mode identity until Firebase Auth is wired up (backend must run with the "local" profile).
# Change it to act as a different user.
EXPO_PUBLIC_DEV_USER=dev-ian
